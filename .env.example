# QuantumSentinel — environment configuration
# Copy to .env and fill in as needed. All values are optional; the app
# runs end-to-end against the PostgreSQL service in docker-compose.yml
# (docker compose up -d postgres).

# --- Web / auth ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://quantumsentinel:quantumsentinel@localhost:5432/quantumsentinel
# Connection pool per process (API worker / research worker). Keep
# processes x (DB_POOL_SIZE + DB_MAX_OVERFLOW) below the server max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
# Generate a stable RS256 keypair for production and encode PEM newlines as \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_ENCRYPTION_KEY=
PRIVATE_KEY_ENCRYPTION_KEY=
# Persist the server ML-DSA identity in a secret manager for cross-restart audit verification.
SERVER_DSA_PRIVATE_KEY=
SERVER_DSA_PUBLIC_KEY=
SERVER_DSA_CREATED_AT=
PQC_PROVIDER=reference
PQC_PROVIDER_URL=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Paper trading ledger ---
# Orders always execute in the internal paper broker (no external broker).
PAPER_INITIAL_CASH=100000
PAPER_MAX_POSITION_FRACTION=0.05
ORDER_SWEEP_INTERVAL_SECONDS=5
