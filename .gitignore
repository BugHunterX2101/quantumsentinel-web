__pycache__/
*.pyc
*.db
.env
server.log
run.log
.venv/
.venv313/
node_modules/

# C++ build artefacts — keep source (.cpp, .py) and pre-built .pyd
cpp/build/
cpp/*.a
cpp/*.def
cpp/*.o

# Platform DLLs shipped alongside the .pyd (re-copied on rebuild)
backend/services/libwinpthread-1.dll
backend/services/python313.dll

# Platform-specific extension modules are produced by CI/Docker, never tracked.
cpp/_qs_fast*.pyd
cpp/_qs_fast*.so
cpp/*.egg-info/
backend/services/_qs_fast*.pyd
backend/services/_qs_fast*.so
