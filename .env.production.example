ENVIRONMENT=production

# Required infrastructure credentials. Use Docker/Kubernetes secret mounts in real deployments.
# Each password below goes into a connection URL, so make it URL-safe, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The bootstrap superuser. docker-compose.production.yml passes it only to
# the postgres and provision services, never to the application.
POSTGRES_PASSWORD=replace-with-a-random-32-plus-character-value
REDIS_PASSWORD=replace-with-a-random-32-plus-character-value
# Least-privilege roles (backend/db_roles.py): the API connects as qs_app,
# migrations run as qs_migrator, backups as qs_backup. The compose file builds
# each service's DATABASE_URL from these, so DATABASE_URL is not set here.
DB_APP_PASSWORD=replace-with-a-random-32-plus-character-value
DB_MIGRATOR_PASSWORD=replace-with-a-random-32-plus-character-value
DB_BACKUP_PASSWORD=replace-with-a-random-32-plus-character-value
REDIS_URL=redis://:REPLACED_BY_COMPOSE@redis:6379/0

# Required in production; random 32+ character values.
REFRESH_TOKEN_SECRET=
CSRF_SECRET=

# Stable RS256 PEM keys with literal \n escapes.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Fernet keys; generate with Fernet.generate_key().
WEBHOOK_ENCRYPTION_KEY=
PRIVATE_KEY_ENCRYPTION_KEY=

# Persisted ML-DSA server identity from the managed PQC/HSM service.
SERVER_DSA_PRIVATE_KEY=
SERVER_DSA_PUBLIC_KEY=
SERVER_DSA_CREATED_AT=
PQC_PROVIDER=external
PQC_PROVIDER_URL=https://pqc-provider.internal

CORS_ORIGINS=https://your-domain.example
ALLOWED_HOSTS=your-domain.example
PAPER_INITIAL_CASH=100000
PAPER_MAX_POSITION_FRACTION=0.05

# Operators (global/asset kill switches) are provisioned by role, never by
# email configuration:  python -m backend.manage set-role <email> risk_admin
# Any authenticated user may still halt their OWN trading (scope=user).
